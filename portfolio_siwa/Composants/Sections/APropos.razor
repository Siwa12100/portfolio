@namespace portfolio_siwa.Composants.Sections

@using portfolio_siwa.Donnees
@using portfolio_siwa.Modeles

<div class="apropos" data-reveal>
    <div class="apropos__texte">
        <p>@Traductions.AProposOrigine.Balise(this.Langue)</p>
        <p>@Traductions.AProposEnedis.Balise(this.Langue)</p>
        <p>@Traductions.AProposAssociations.Balise(this.Langue)</p>
        <p>@Traductions.AProposCulture.Balise(this.Langue)</p>
        <p>@Traductions.AProposConclusion.Balise(this.Langue)</p>
    </div>

    <div class="apropos__contact">
        <h3>@Traductions.MeContacter[this.Langue]</h3>
        <p>@Traductions.ContactAccroche[this.Langue]</p>

        @* Le mailto ouvre le client mail quand il y en a un. Sinon, l'adresse reste
           lisible et copiable d'un clic : sur un poste sans client configuré, un
           mailto seul ne déclenche rien du tout. *@
        <div class="apropos__actions">
            <a class="bouton bouton--plein" href="mailto:@PlanDuSite.Courriel">@Traductions.EcrivezMoi[this.Langue]</a>
            <button type="button" class="adresse" data-copier="@PlanDuSite.Courriel"
                    data-message="@Traductions.AdresseCopiee[this.Langue]"
                    title="@Traductions.CopierAdresse[this.Langue]">
                @PlanDuSite.Courriel
            </button>
        </div>

        <Contacts />
    </div>
</div>

@code {
    [CascadingParameter]
    private Langue Langue { get; set; }
}
