@namespace portfolio_siwa.Composants.Sections

@using portfolio_siwa.Donnees

@* Format resserré pour les projets qui suivent les quatre mis en avant :
   même information, moitié moins de hauteur. *@
<article class="compacte" data-reveal>
    <div class="compacte__visuel">
        @* Colonne de 260 px au-dessus de 720 px, pleine largeur en dessous : le navigateur
           choisit la variante la plus légère qui suffit à cet affichage. *@
        <img src="@this.Fiche.Image" srcset="@this.Fiche.SrcSet" sizes="(min-width: 721px) 260px, 100vw"
             alt="@($"{Traductions.ApercuDe[this.Langue]} {this.Fiche.Titre[this.Langue]}")"
             width="@this.Fiche.ImageLargeur" height="@this.Fiche.ImageHauteur"
             loading="lazy" decoding="async" />
    </div>

    <div class="compacte__corps">
        <p class="compacte__meta">
            <span class="compacte__categorie">@this.Fiche.Categorie[this.Langue]</span>
            @if (this.Fiche.Annee is not null)
            {
                <span>@this.Fiche.Annee[this.Langue]</span>
            }
            @if (this.Fiche.Cadre is not null)
            {
                <span>@this.Fiche.Cadre[this.Langue]</span>
            }
        </p>

        <h4 class="compacte__titre">@this.Fiche.Titre[this.Langue]</h4>
        <p class="compacte__resume">@this.Fiche.ResumeCourt[this.Langue]</p>

        @* La description complète, sans survol ni JavaScript : elle s'ouvre au toucher comme
           au clavier, et les lecteurs d'écran la lisent. *@
        <details class="compacte__plus">
            <summary>@Traductions.EnSavoirPlus[this.Langue]</summary>
            <div class="compacte__complet">@this.Fiche.Resume.Balise(this.Langue)</div>
        </details>

        <ul class="puces">
            @foreach (var techno in this.Fiche.Technos)
            {
                <li>
                    <button type="button" class="puce" aria-expanded="false">
                        <img src="@techno.Logo" alt="" width="17" height="17" loading="lazy" />
                        <span class="puce__nom">@techno.Nom</span>
                        <span class="puce__role">@techno.Role[this.Langue]</span>
                    </button>
                </li>
            }
        </ul>

        @if (this.Fiche.LienSite is not null || this.Fiche.LienGithub is not null)
        {
            <div class="compacte__liens">
                @if (this.Fiche.LienSite is not null)
                {
                    <a class="bouton bouton--discret bouton--petit" href="@this.Fiche.LienSite"
                       target="_blank" rel="noopener noreferrer">@Traductions.VoirLeSite[this.Langue]</a>
                }
                @if (this.Fiche.LienGithub is not null)
                {
                    <a class="bouton bouton--discret bouton--petit" href="@this.Fiche.LienGithub"
                       target="_blank" rel="noopener noreferrer">@Traductions.CodeSource[this.Langue]</a>
                }
            </div>
        }
    </div>
</article>
