@page "/erreur/{Code:int}"

@using portfolio_siwa.Donnees
@using portfolio_siwa.Modeles

<section class="section">
    <div class="contenu-limite mesure statut">
        <p class="etiquette">@Traductions.Erreur[this.Langue] @this.Code</p>
        <h1>@this.Titre</h1>
        <p>@this.Message</p>
        <a class="bouton bouton--plein" href="@this.Langue.Accueil()">@Traductions.RetourAccueil[this.Langue]</a>
    </div>
</section>

@code {
    [Parameter]
    public int Code { get; set; }

    [CascadingParameter]
    private Langue Langue { get; set; }

    private string Titre => this.Code == 404
        ? Traductions.PageIntrouvableTitre[this.Langue]
        : Traductions.ErreurTitre[this.Langue];

    private string Message => this.Code == 404
        ? Traductions.PageIntrouvableTexte[this.Langue]
        : Traductions.ErreurTexte[this.Langue];
}
