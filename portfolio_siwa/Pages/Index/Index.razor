@page "/"

@using portfolio_siwa.Composants.Sections
@using portfolio_siwa.Donnees

<Hero />

<section id="projets" class="section">
    <div class="contenu-limite">
        <h2 class="titre-section">Réalisations</h2>

        @* Les quatre premières fiches du catalogue sont mises en avant, les suivantes
           passent en format compact pour garder la page lisible sur mobile. *@
        <div class="liste-projets">
            @for (var i = 0; i < NombreMisEnAvant; i++)
            {
                var fiche = CatalogueProjets.Tous[i];
                <CarteProjet Fiche="fiche" Inverse="@(i % 2 == 1)" />
            }
        </div>

        @if (CatalogueProjets.Tous.Count > NombreMisEnAvant)
        {
            <h3 class="titre-sous-section">Autres projets</h3>

            <div class="liste-compacte">
                @foreach (var fiche in CatalogueProjets.Tous.Skip(NombreMisEnAvant))
                {
                    <CarteProjetCompacte Fiche="fiche" />
                }
            </div>
        }
    </div>
</section>

<section id="apropos" class="section">
    <div class="contenu-limite">
        <h2 class="titre-section">À propos</h2>
        <APropos />
    </div>
</section>

@code {
    private const int NombreMisEnAvant = 4;
}
