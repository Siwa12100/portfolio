@page "/mentions-legales"
@page "/en/legal-notice"
@page "/oc/mencions-legalas"

@using portfolio_siwa.Donnees
@using portfolio_siwa.Modeles

<section class="section">
    <div class="contenu-limite mesure legales">
        <h1>@Traductions.MentionsLegales[this.Langue]</h1>

        <h2>@Traductions.LegalEditeurTitre[this.Langue]</h2>
        <p>
            @Traductions.LegalEditeurTexte[this.Langue]<br />
            @Traductions.LegalContact[this.Langue] :
            <a href="mailto:@PlanDuSite.Courriel">@PlanDuSite.Courriel</a>
        </p>

        <h2>@Traductions.LegalHebergementTitre[this.Langue]</h2>
        <p>@Traductions.LegalHebergementTexte[this.Langue]</p>

        <h2>@Traductions.LegalProprieteTitre[this.Langue]</h2>
        <p>@Traductions.LegalProprieteTexte[this.Langue]</p>

        <h2>@Traductions.LegalDonneesTitre[this.Langue]</h2>
        <p>@Traductions.LegalDonneesTexte[this.Langue]</p>

        <p><a href="@this.Langue.Accueil()">@Traductions.RetourAccueil[this.Langue]</a></p>
    </div>
</section>

@code {
    [CascadingParameter]
    private Langue Langue { get; set; }
}
