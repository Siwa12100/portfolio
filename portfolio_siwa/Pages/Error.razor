@page "/Error"

@using System.Diagnostics
@using portfolio_siwa.Donnees
@using portfolio_siwa.Modeles

<section class="section">
    <div class="contenu-limite mesure statut">
        <p class="etiquette">@Traductions.Erreur[this.Langue]</p>
        <h1>@Traductions.ErreurTitre[this.Langue]</h1>
        <p>@Traductions.ErreurTexte[this.Langue]</p>
        <a class="bouton bouton--plein" href="@this.Langue.Accueil()">@Traductions.RetourAccueil[this.Langue]</a>

        @if (this.AfficherIdentifiant)
        {
            <p><strong>@Traductions.ErreurIdentifiant[this.Langue] :</strong> <code>@this.Identifiant</code></p>
        }
    </div>
</section>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [CascadingParameter]
    private Langue Langue { get; set; }

    private string? Identifiant { get; set; }

    private bool AfficherIdentifiant => !string.IsNullOrEmpty(this.Identifiant);

    protected override void OnInitialized() =>
        this.Identifiant = Activity.Current?.Id ?? this.HttpContext?.TraceIdentifier;
}
