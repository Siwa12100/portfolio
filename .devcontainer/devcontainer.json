{
  "name": "Portfolio",
  // Image devcontainers officielle : SDK .NET 9 + utilisateur vscode (uid 1000),
  // zsh et oh-my-zsh déjà inclus, donc ni Dockerfile, ni compose, ni features.
  // Garder le 9.0 aligné sur le TargetFramework, la CI (.drone.yml) et le Dockerfile de prod.
  "image": "mcr.microsoft.com/devcontainers/dotnet:1-9.0",

  // Sans ça, les builds tournent en root et sèment des fichiers root dans bin/ et obj/,
  // à travers le bind mount, jusque chez l'hôte.
  "remoteUser": "vscode",

  "containerEnv": {
    "ASPNETCORE_ENVIRONMENT": "Development",
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_NOLOGO": "1",
    // dotnet watch essaie sinon d'ouvrir un navigateur dans le conteneur.
    "DOTNET_WATCH_SUPPRESS_LAUNCH_BROWSER": "1",
    "DOTNET_WATCH_RESTART_ON_RUDE_EDIT": "1"
  },

  // Profil "http" de Properties/launchSettings.json.
  "forwardPorts": [5087],
  "portsAttributes": {
    "5087": {
      "label": "Portfolio",
      "onAutoForward": "openBrowser"
    }
  },

  "postCreateCommand": "dotnet restore portfolio_siwa.sln",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "usernamehw.errorlens"
      ],
      "settings": {
        "dotnet.defaultSolution": "portfolio_siwa.sln",
        "terminal.integrated.defaultProfile.linux": "zsh"
      }
    }
  }
}
